#!/bin/sh
#
# PROVIDE: lobotomy
# REQUIRE: LOGIN networking
# KEYWORD: shutdown

. /etc/rc.subr

name="lobotomy"
rcvar="lobotomy_enable"
desc="Lobotomy knowledge base server"

load_rc_config $name

: ${lobotomy_enable:="NO"}
: ${lobotomy_user:="www"}
: ${lobotomy_group:="www"}
: ${lobotomy_dir:="/var/www/Lobotomy"}
: ${lobotomy_python:="/usr/local/bin/python3"}
: ${lobotomy_log:="/var/log/lobotomy.log"}

pidfile="/var/run/${name}/${name}.pid"
procname="${lobotomy_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -o ${lobotomy_log} \
    ${lobotomy_python} ${lobotomy_dir}/tools/serve.py"

start_precmd="${name}_prestart"

lobotomy_prestart()
{
    install -d -o "${lobotomy_user}" -g "${lobotomy_group}" -m 755 \
        "/var/run/${name}"

    touch "${lobotomy_log}"
    chown "${lobotomy_user}:${lobotomy_group}" "${lobotomy_log}"

    chown -R "${lobotomy_user}:${lobotomy_group}" \
        "${lobotomy_dir}/wiki" \
        "${lobotomy_dir}/raw"

    for f in "${lobotomy_dir}/config.json" \
              "${lobotomy_dir}/.user.json" \
              "${lobotomy_dir}/.tokens.json" \
              "${lobotomy_dir}/.login_log.json"; do
        [ -f "$f" ] && chown "${lobotomy_user}:${lobotomy_group}" "$f"
    done

    [ -d "${lobotomy_dir}/wiki/.jobs" ] && \
        chown -R "${lobotomy_user}:${lobotomy_group}" "${lobotomy_dir}/wiki/.jobs"
}

run_rc_command "$1"
